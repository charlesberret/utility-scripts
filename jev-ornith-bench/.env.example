# --- Jev / TypeSafe (arm: jev) -------------------------------------------
# Key from https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional overrides; defaults are https://api.typesafe.ai and jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- Ornith (arms: solo, constrained, and all generation) ----------------
# Any OpenAI-compatible server: vLLM, SGLang, llama.cpp, Ollama, LM Studio.
ORNITH_BASE_URL=http://localhost:8000/v1
ORNITH_API_KEY=EMPTY
ORNITH_MODEL=Ornith-1.5-9B

# Sampling. The model card recommends these for normal use; the published
# benchmark numbers were produced at temperature=1.0.
ORNITH_TEMPERATURE=0.6
ORNITH_TOP_P=0.95
ORNITH_TOP_K=20
